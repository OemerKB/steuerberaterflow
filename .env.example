# SteuerberaterFlow – Environment Variables
# Kopiere diese Datei nach .env und fülle die Werte aus.
# Niemals echte Secrets committen!

# PostgreSQL-Verbindung (z. B. Neon, Supabase oder lokales Postgres)
# pooled Connection für die Anwendung:
DATABASE_URL="postgresql://user:password@host/steuerberaterflow?sslmode=require"
# unpooled Connection für Migrationen (Neon):
DATABASE_URL_UNPOOLED="postgresql://user:password@host/steuerberaterflow?sslmode=require"

# Secret für Session-Signierung (mind. 32 Zeichen, z. B. via `openssl rand -base64 32`)
AUTH_SECRET="change-me-please-32-chars-minimum"

# Öffentliche Basis-URL der App (für Links in E-Mails/Einladungen)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_LANDING_URL="http://localhost:3001"

# ------------------------- Optionale Integrationen -------------------------
# E-Mail-Versand über Resend (ohne Konfiguration werden E-Mails nur geloggt)
RESEND_API_KEY=""
EMAIL_FROM="SteuerberaterFlow <noreply@example.com>"

# Video-Beratung (Daily.co) – ohne Konfiguration wird ein Demo-Meetingraum genutzt
DAILY_API_KEY=""
DAILY_DOMAIN=""

# KI-Analyse (ohne Konfiguration läuft der Mock-Modus)
OPENAI_API_KEY=""

# Storage-Adapter (MVP: "db" – Dateien verschlüsselt-in-DB; "supabase" vorbereitet)
STORAGE_DRIVER="db"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe (Phase 3 – vorbereitet, im MVP inaktiv)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
